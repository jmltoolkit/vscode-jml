{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Extension",
            "type": "npm",
            "script": "esbuild",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Bundles the extension using esbuild"
        },
        {
            "label": "Compile TypeScript",
            "type": "npm",
            "script": "compile",
            "problemMatcher": ["$tsc"],
            "group": "build",
            "detail": "Compiles TypeScript to JavaScript"
        },
        {
            "label": "Run Tests",
            "type": "npm",
            "script": "test",
            "problemMatcher": [],
            "group": "test",
            "detail": "Runs extension integration tests"
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "${execPath} ./node_modules/mocha/bin/mocha -r ts-node/register src/test/suite/**/*.test.ts",
            "problemMatcher": [],
            "group": "test",
            "detail": "Runs unit tests directly with mocha"
        },
        {
            "label": "Lint",
            "type": "npm",
            "script": "lint",
            "problemMatcher": ["$eslint-stylish"],
            "group": "build",
            "detail": "Runs ESLint on source files"
        },
        {
            "label": "Watch Build",
            "type": "npm",
            "script": "esbuild-watch",
            "problemMatcher": [],
            "detail": "Watches and rebuilds on changes"
        },
        {
            "label": "Package Extension",
            "type": "npm",
            "script": "package",
            "problemMatcher": [],
            "detail": "Packages the extension as .vsix file"
        }
    ]
}